<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#a5cbcc"
    tools:context=".inicio.tienda_registro">

    <!-- logo -->
    <ImageView
        android:id="@+id/img_registro_logo"
        android:layout_width="148dp"
        android:layout_height="77dp"
        android:src="@drawable/registro"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- titulo -->
    <TextView
        android:id="@+id/txt_registro_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registro"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/img_registro_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_registro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/txt_registro_titulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="28dp">

            <TextView
                android:id="@+id/txt_registro_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Por favor completa todos los campos"
                android:textColor="@android:color/black" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <!-- correo -->
            <TextView
                android:id="@+id/txt_registro_correo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORREO"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <EditText
                android:id="@+id/edt_registro_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:hint="ejemplo@correo.com" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- contraseña -->
            <TextView
                android:id="@+id/txt_registro_contraseña"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTRASEÑA"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <EditText
                android:id="@+id/edt_registro_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:hint="********" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <!-- btn registar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_registrar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Registrarse"
                app:cornerRadius="32dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/my_primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:id="@+id/txt_login_link"
                android:layout_width="219dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/my_primary"
                android:textSize="14sp"
                android:text="Inicia Sesion"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
