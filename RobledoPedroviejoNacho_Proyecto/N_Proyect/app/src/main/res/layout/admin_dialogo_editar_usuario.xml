<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/cuadro_dialogo_usuario">

    <!-- titulo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <!-- ico titulo-->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_edit"
            android:layout_marginEnd="12dp"
            app:tint="#3F51B5" />

        <!-- editar user -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar usuario"
            android:textColor="#3F51B5"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!--mostrar correo-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical">

        <!-- ico correo -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_dialog_email"
            android:layout_marginEnd="12dp"
            app:tint="#3F51B5" />

        <!-- txt correo-->
        <TextView
            android:id="@+id/textoCorreoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#212121"
            android:textSize="16sp"
            android:paddingVertical="8dp"
            android:textStyle="italic"/>
    </LinearLayout>

    <!--selecionar rol user-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <!--ico config-->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_manage"
            android:layout_marginEnd="12dp"
            app:tint="#3F51B5" />

        <!-- cont spinner roles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--txt rol -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rol:"
                android:textColor="#3F51B5"
                android:textSize="16sp"
                android:layout_marginBottom="6dp"/>

            <!-- seleccionar rol -->
            <Spinner
                android:id="@+id/spinnerRoles"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/spinner_usuario"/>
        </LinearLayout>
    </LinearLayout>

    <!-- btn guardar-->
    <Button
        android:id="@+id/botonGuardarCambios"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="Guardar cambios"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:background="@drawable/boton_usuario"
        android:stateListAnimator="@null"/>
</LinearLayout>
